#!/bin/sh

set -e

OLD_CONF=/etc/qdb/qdb_rest.conf
OLD_UNIT=/etc/systemd/system/qdb_rest.service

# Earlier versions of this package copied their unit to /etc/systemd/system,
# where it takes precedence over the unit this package ships. That unit
# starts the server with --config-file, which qdb_rest no longer accepts.
if [ -f $OLD_UNIT ] && grep -q -- '--config-file' $OLD_UNIT; then
    rm -f $OLD_UNIT
fi

# qdb_rest logs to stdout and writes no log file.
rm -f /etc/logrotate.d/qdb_rest

if [ -f $OLD_CONF ]; then
    cat <<NOTICE
qdb-rest: $OLD_CONF is no longer read.
qdb-rest: The configuration is now /etc/qdb/qdb_rest.yaml, in a new format,
qdb-rest: and the service starts with the defaults of that file.
qdb-rest: Copy your settings into it and run: systemctl restart qdb_rest
qdb-rest: $OLD_CONF and the certificate files in /etc/qdb are left in place.
NOTICE
fi

systemctl daemon-reload 2>&1 || true
systemctl -q enable qdb_rest.service 2>&1 || true
systemctl start qdb_rest.service 2>&1 || true
