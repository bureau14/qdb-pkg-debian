#!/bin/sh

# Allow errors to make sure the package can always be removed
set +e

if systemctl is-active -q qdb_rest; then
    echo "Stopping qdb_rest..."
    systemctl stop qdb_rest.service
fi

# dpkg removes the unit file after this script, and systemctl disables
# only a unit it can still read.
if [ "$1" = "remove" ]; then
    systemctl -q disable qdb_rest.service 2>&1 || true
fi
