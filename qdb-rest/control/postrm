#!/bin/sh

USER="qdb"

# Allow errors to make sure the package can always be removed
set +e

if [ "$1" = "purge" ]; then
    rmdir --ignore-fail-on-non-empty /etc/qdb/
    # qdb-server runs as the same user.
    if ! command -v qdbd > /dev/null 2>&1; then
        userdel $USER
    fi
fi

if [ "$1" != "upgrade" ]; then
    systemctl daemon-reload 2>&1 || true
fi
